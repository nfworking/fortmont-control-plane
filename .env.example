DATABASE_URL=

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=system_metrics

NEXT_PUBLIC_API_HOST=http://localhost:8090

# Better Auth GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare R2 (S3-compatible) settings for profile avatar uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional. Set this to your public bucket domain or custom domain.
# Example: https://assets.example.com
R2_PUBLIC_URL_BASE=

# Redis Cloud (control plane backend admin connection).
# Use rediss:// for TLS-enabled Redis Cloud deployments.
REDIS_URL=

# Agent Redis transport policy.
# Presence TTL controls online/offline liveness projection.
AGENT_REDIS_PRESENCE_TTL_SEC=90
# Session TTL controls how long issued per-agent Redis credentials remain valid.
AGENT_REDIS_SESSION_TTL_SEC=900
# Session mode:
# - acl: control plane creates per-agent ACL users (requires ACL SETUSER permission)
# - shared: control plane returns static scoped Redis credentials
AGENT_REDIS_SESSION_MODE=shared
# Required when AGENT_REDIS_SESSION_MODE=shared (or as ACL fallback creds).
REDIS_AGENT_USERNAME=
REDIS_AGENT_PASSWORD=
